# ==========================================
# CodeGraph Server Environment Configuration
# ==========================================

# Port to bind server (injected automatically on Render, Railway, Fly, Heroku)
PORT=5000

# Environment mode ('production' or 'development')
NODE_ENV=production

# CORS allowed origins (comma separated, or * for all)
CORS_ORIGIN=*

# Path to python binary (defaults to 'python3' on Linux and 'python' on Windows)
# PYTHON_BIN=python3
